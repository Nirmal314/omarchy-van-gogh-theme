# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0a192f"

# Main text color
theme[main_fg]="#f2e2a4"

# Title color for boxes
theme[title]="#f2e2a4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#e6b422"

# Background color of selected item in processes box
theme[selected_bg]="#1c3a5e"

# Foreground color of selected item in processes box
theme[selected_fg]="#e6b422"

# Color of inactive/disabled text
theme[inactive_fg]="#2c4668"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#f6f1c1"

# Background color of the percentage meters
theme[meter_bg]="#1c3a5e"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#f6f1c1"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#d9822b"
theme[mem_box]="#7fb3d5"
theme[net_box]="#d9822b"
theme[proc_box]="#e6b422"

# Box divider line and small boxes line color
theme[div_line]="#2c4668"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#7fb3d5"
theme[temp_mid]="#f2e2a4"
theme[temp_end]="#d9822b"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#9fd3c7"
theme[cpu_mid]="#4a78a8"
theme[cpu_end]="#d9822b"

# Mem/Disk free meter
theme[free_start]="#d9822b"
theme[free_mid]="#4a78a8"
theme[free_end]="#9fd3c7"

# Mem/Disk cached meter
theme[cached_start]="#4a78a8"
theme[cached_mid]="#9fd3c7"
theme[cached_end]="#d9822b"

# Mem/Disk available meter
theme[available_start]="#f2e2a4"
theme[available_mid]="#d9822b"
theme[available_end]="#d9822b"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#7fb3d5"
theme[used_mid]="#9fd3c7"
theme[used_end]="#4a78a8"

# Download graph colors
theme[download_start]="#f2e2a4"
theme[download_mid]="#d9822b"
theme[download_end]="#d9822b"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#7fb3d5"
theme[upload_mid]="#9fd3c7"
theme[upload_end]="#4a78a8"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#9fd3c7"
theme[process_mid]="#4a78a8"
theme[process_end]="#d9822b"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#0a192f"
theme[gradient_color_1]="#1c3a5e"
theme[gradient_color_2]="#1c3a5e"
theme[gradient_color_3]="#2c4668"
theme[gradient_color_4]="#a08b52"
theme[gradient_color_5]="#f2e2a4"
theme[gradient_color_6]="#f6f1c1"
theme[gradient_color_7]="#fff3c4"
